{
  "name": "birsa-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BIRSA Portal, the bilingual student portal for the BIR Student Association, Faculty of Political Science, Thammasat University.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "payload": "payload --use-swc",
    "generate:types": "payload generate:types --use-swc",
    "generate:importmap": "payload generate:importmap --use-swc",
    "migrate:content": "payload run scripts/migrate-content-to-payload.ts --use-swc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/postgres": "^0.10.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "graphql": "^16.14.2",
    "gray-matter": "^4.0.3",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "payload": "^3.86.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "resend": "^4.0.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@swc-node/register": "^1.11.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
