# Copy this file to `.env.local` and fill in the values.
# None of these are required for the site to build or run — forms fall back
# gracefully to an "email us directly" message if email is not configured.

# Public base URL of the deployed site (used for canonical URLs, sitemap, hreflang).
NEXT_PUBLIC_SITE_URL=https://birsa.example.org

# --- Form email delivery (optional) -----------------------------------------
# Get a free API key at https://resend.com. If unset, form submissions are
# validated but the user is asked to email BIRSA directly instead.
RESEND_API_KEY=

# The inbox that form submissions are delivered to.
BIRSA_INBOX=birsa@tu.ac.th

# The verified "from" address Resend sends on behalf of (must be a domain you
# have verified in Resend). Example: no-reply@birsa.example.org
CONTACT_FROM=BIRSA Portal <no-reply@birsa.example.org>

# --- Equipment Loan Service (optional) --------------------------------------
# Without these, the loan backend degrades gracefully: public pages still
# render, but requests report the service as not configured.

# Vercel Postgres connection string. Auto-set by the Vercel Postgres
# integration when attached to this project — you normally don't set this
# by hand. Run db/schema.sql once against the database to create the table.
POSTGRES_URL=

# Random long string used to sign the per-officer session cookie. Generate
# with, e.g., `openssl rand -hex 32`.
OFFICER_SESSION_SECRET=

# --- Inventory suite: notifications cron (optional) -------------------------
# Secret the daily Vercel Cron job (/api/cron/daily) must present as a
# Bearer token. Generate with `openssl rand -hex 32`. If unset, the cron
# endpoint reports itself as not configured and sends no reminders.
CRON_SECRET=

# --- Inventory suite: item photos (optional) -------------------------------
# Vercel Blob read/write token. Auto-set by the Vercel Blob integration when
# attached to this project. If unset, photo uploads report as not configured
# and the catalogue simply shows no image.
BLOB_READ_WRITE_TOKEN=

# --- Emergency mode (optional) ---------------------------------------------
# Vercel Edge Config connection string. Auto-set by the Vercel Edge Config
# integration when attached to this project. Controls the site-wide emergency
# banner + pages via an item keyed `emergency`. Edge Config only SELECTS which
# pre-prepared scenario is live; the content lives in content/emergency/.
#   {
#     "active": true,
#     "scenario": "flooding",
#     "messageOverride": { "en": "", "th": "" }
#   }
# - active: master on/off switch for the banner.
# - scenario: which scenario page to show (a registered id under
#   content/emergency/scenarios/; unknown/missing falls back to "generic").
# - messageOverride: optional per-incident banner text that wins over the
#   scenario's default; leave blank to use the scenario's own message.
# Change these in the Vercel dashboard to switch scenarios with no redeploy.
# If unset, emergency mode is simply always off.
EDGE_CONFIG=
