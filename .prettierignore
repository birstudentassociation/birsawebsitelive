# Prettier does not read .gitignore, so every generated path that Prettier
# would otherwise walk has to be repeated here. Without this file, running
# `npm run format:check` after a build fails on the framework's own output.

# Build output
/.next/
/.next-verify/
/out/
/build/

# Test and audit output
/coverage/
/playwright-report/
/test-results/
/.playwright/
/.lighthouseci/

# Generated by npm, not by hand. Prettier happens to agree with npm's
# formatting today, but that is npm's choice to change, not ours to enforce.
package-lock.json

# Scratch workspace for agent-driven development runs; never part of the repo.
/.superpowers/
